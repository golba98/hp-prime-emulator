+static uint32_t bounded_rate(uint64_t rate)
+{
+    return rate <= UINT32_MAX ? rate : 0;
+}
+
+static uint32_t pll_rate(uint32_t parent, uint32_t con, uint32_t k, bool epll)
+{
+    unsigned m = (con >> (epll ? 16 : 14)) & (epll ? 255 : 1023);
+    unsigned p = (con >> (epll ? 8 : 5)) & 63;
+    unsigned shift = con & 7;
+    uint64_t rate;
+    if (!p) { return 0; }
+    if (epll) {
+        rate = (uint64_t)parent * ((m << 16) + (k & 65535));
+        rate = (rate / ((uint64_t)p << shift)) >> 16;
+    } else {
+        rate = (uint64_t)parent * m / ((uint64_t)p << shift);
+    }
+    return bounded_rate(rate);
+}
+
+static void update_clocks(S3C2416SYSC *s)
+{
+    uint32_t pclk = 66000000, uart_pclk = 24000000, uart_sclk = 0;
+    if (s->clock_tree) {
+        uint32_t src = s->regs[REG(0x20)], div = s->regs[REG(0x24)];
+        uint32_t mpllref = s->xti_hz / ((src & 8) ? 2 * ((div >> 6) & 7) + 1 : 1);
+        uint32_t msys = (src & 16) ? pll_rate(mpllref, s->regs[REG(0x10)], 0, false) : mpllref;
+        unsigned hdiv = div & 3;
+        unsigned erefsel = (src >> 7) & 3;
+        uint32_t eref = erefsel < 2 ? mpllref : erefsel == 2 ? s->xti_hz : s->ext_hz;
+        uint32_t esys = (src & 64) ? pll_rate(eref, s->regs[REG(0x18)], s->regs[REG(0x1c)], true) : eref;
+        pclk = hdiv == 2 ? 0 : msys / (((div >> 4) & 3) + 1) / (hdiv + 1) / (((div >> 2) & 1) + 1);
+        uart_pclk = (s->regs[REG(0x34)] & 1) ? pclk : 0;
+        uart_sclk = (s->regs[REG(0x38)] & (1 << 8)) ? esys / (((s->regs[REG(0x28)] >> 8) & 15) + 1) : 0;
+        if (!(s->regs[REG(0x34)] & (1 << 10))) { pclk = 0; }
+        if (!msys || hdiv == 2) {
+            qemu_log_mask(LOG_UNIMP, "s3c2416-sysc: invalid/unsupported main clock stops peripheral clocks\n");
+        }
+    }
+    if (s->pwm) { s3c2416_pwm_set_clock(s->pwm, pclk); }
+    if (s->uart) { s3c2416_uart_set_clock(s->uart, uart_pclk, uart_sclk, s->clock_tree); }
+}
+
+void s3c2416_sysc_connect(DeviceState *dev, DeviceState *pwm, DeviceState *uart)
+{
+    S3C2416SYSC *s = SYSC(dev);
+    s->pwm = pwm; s->uart = uart;
+    update_clocks(s);
+}
+
+static uint64_t sysc_read(void *opaque, hwaddr offset, unsigned size)
+{
+    S3C2416SYSC *s = opaque;
+    if (valid_offset(offset)) { return s->regs[REG(offset)]; }
+    qemu_log_mask(LOG_GUEST_ERROR, "s3c2416-sysc: bad read 0x%" HWADDR_PRIx "\n", offset);
+    return 0;
+}
+
+static void sysc_write(void *opaque, hwaddr offset, uint64_t val, unsigned size)
+{
+    S3C2416SYSC *s = opaque;
+    if (!valid_offset(offset)) {
+        qemu_log_mask(LOG_GUEST_ERROR, "s3c2416-sysc: bad write 0x%" HWADDR_PRIx "\n", offset);
+        return;
+    }
+    if (offset == 0x44) {
+        if (val == 0x533c2416) {
+            s->software_reset = true;
+            qemu_system_reset_request(SHUTDOWN_CAUSE_GUEST_RESET);
+        } else {
+            qemu_log_mask(LOG_GUEST_ERROR, "s3c2416-sysc: invalid SWRST key ignored\n");
+        }
+        return;
+    }
+    if (offset == 0x6c) {
+        s->regs[REG(offset)] &= ~val; /* WKUPSTAT is write-one-to-clear. */
+        return;
+    }
+    if (offset == 0x68) {
+        qemu_log_mask(LOG_UNIMP, "s3c2416-sysc: reset/wakeup status writes unsupported\n");
+        return;
+    }
+    s->regs[REG(offset)] = val;
+    if ((offset >= 0x10 && offset <= 0x38)) { update_clocks(s); }
+}
+
+static void sysc_reset(DeviceState *dev)
+{
+    S3C2416SYSC *s = SYSC(dev);
+    uint32_t saved[0x90 / 4];
+    bool soft = s->software_reset;
+    unsigned i;
+    memcpy(saved, s->regs, sizeof(saved));
+    memset(s->regs, 0, sizeof(s->regs));
+    s->regs[REG(0)] = s->regs[REG(4)] = 0xffff;
+    s->regs[REG(8)] = 0x8000;
+    s->regs[REG(0x10)] = 0x18540c0;
+    s->regs[REG(0x18)] = 0x1200102;
+    s->regs[REG(0x24)] = 0xc;
+    s->regs[REG(0x30)] = s->regs[REG(0x34)] = 0xffffffff;
+    s->regs[REG(0x38)] = 0xffffdfff;
+    s->regs[REG(0x64)] = 0x60101;
+    s->regs[REG(0x68)] = 1;
+    if (soft) {
+        const unsigned retain[] = {8, 0x60, 0x64, 0x68, 0x6c, 0x70, 0x74, 0x78, 0x7c};
+        for (i = 0; i < ARRAY_SIZE(retain); i++) { s->regs[REG(retain[i])] = saved[REG(retain[i])]; }
+    }
+    if (soft) { s->regs[REG(0x68)] = 0x20; } /* Rev1.10 2-35 SWRST cause. */
+    s->software_reset = false;
+    update_clocks(s);
+}
