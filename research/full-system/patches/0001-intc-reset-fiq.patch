@@ -280,2 +288,15 @@
-        if (s->SRCPND[i] & s->INTMOD[i]) {
-            return s3c2416_get_int_from_val(s->INTMOD[i], i);
+        uint32_t pending = s->SRCPND[i] & s->INTMOD[i];
+        if (pending) {
+            /* A selection mask may contain several bits while only one
+             * source is pending. Never look up the entire selection mask.
+             * Simultaneous FIQ priority remains unverified in this model. */
+            if (pending & (pending - 1)) {
+                qemu_log_mask(LOG_UNIMP, "S3C2416: simultaneous FIQ priority unsupported\n");
+                return -1;
+            }
+            int id = s3c2416_get_int_from_val(pending, i);
+            if (id == INT_END) {
+                qemu_log_mask(LOG_UNIMP, "S3C2416: unsupported FIQ source %#x\n", pending);
+                return -1;
+            }
+            return id;
