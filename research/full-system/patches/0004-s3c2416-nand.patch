+/* Byte-accurate bounded accesses; raw+OOB and main-only images are distinct. */
+static int storage_read(PrimeNand *s, unsigned row, uint8_t *data)
+{
+    int result;
+    if (row >= PAGES) {
+        return -EINVAL;
+    }
+    if (!s->blk) {
+        memcpy(data, s->memory + (uint64_t)row * TOTAL, TOTAL);
+        return 0;
+    }
+    if (s->interleaved) {
+        result = blk_pread(s->blk, (uint64_t)row * TOTAL, data, TOTAL);
+        return result < 0 ? result : 0;
+    }
+    memset(data + PAGE, 0xff, OOB);
+    result = blk_pread(s->blk, (uint64_t)row * PAGE, data, PAGE);
+    return result < 0 ? result : 0;
+}
