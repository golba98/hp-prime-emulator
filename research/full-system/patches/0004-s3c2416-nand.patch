+/* Samsung 1-bit main Hamming parity. Reserved bits24:27 read as ones.
+ * The 512-byte low24-bit layout is independently checked against Linux's
+ * s3c2410 correction syndrome. 2048-byte upper address parity is documented
+ * as research derivation; tests keep it separate from physical verification.
+ */
+static uint32_t main_code(PrimeNand *s)
+{
+    uint32_t code = 0;
+    unsigned i;
+    for (i = 0; i < 11; i++) {
+        unsigned shift = i < 9 ? 2 * i : 28 + 2 * (i - 9);
+        code |= ((s->main_ecc.lp[1] >> i) & 1) << shift;
+        code |= ((s->main_ecc.lp[0] >> i) & 1) << (shift + 1);
+    }
+    code |= (uint32_t)s->main_ecc.cp << 18;
+    return ~code;
+}
