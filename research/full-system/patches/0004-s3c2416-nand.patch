+static int storage_write(PrimeNand *s, unsigned row, const uint8_t *data)
+{
+    int result;
+    if (row >= PAGES || s->readonly) {
+        return -EPERM;
+    }
+    if (!s->blk) {
+        memcpy(s->memory + (uint64_t)row * TOTAL, data, TOTAL);
+        return 0;
+    }
+    if (!s->interleaved) {
+        /* Main-only images have no persistent OOB; writes are unsupported. */
+        return -ENOTSUP;
+    }
+    result = blk_pwrite(s->blk, (uint64_t)row * TOTAL, data, TOTAL, 0);
+    return result < 0 ? result : 0;
+}
