+/* Board bootstrap copies main bytes only. This is a modeled loader, not iROM. */
+int s3c2416_nand_bootstrap(DeviceState *dev, uint8_t *destination, size_t size)
+{
+    PrimeNand *s = NAND_STATE(dev);
+    uint8_t page[TOTAL];
+    unsigned row;
+    if (size > 8192) {
+        return -EINVAL;
+    }
+    for (row = 0; size; row++) {
+        size_t amount = MIN(size, PAGE);
+        if (storage_read(s, row, page) < 0) {
+            return -EIO;
+        }
+        memcpy(destination, page, amount);
+        destination += amount;
+        size -= amount;
+    }
+    return 0;
+}
