+static void compare_ecc(PrimeNand *s)
+{
+    uint32_t stored = (s->ecc_input[0] & 0xff) |
+                     ((s->ecc_input[0] >> 8) & 0xff00) |
+                     ((s->ecc_input[1] & 0xff) << 16) |
+                     ((s->ecc_input[1] << 8) & 0xff000000);
+    uint32_t diff = (stored ^ main_code(s)) & 0xf0ffffff;
+    unsigned byte = 0, bit = 0, i;
+    s->ecc_error = 0;
+    if (!diff) {
+        return;
+    }
+    if (!(diff & (diff - 1))) {
+        s->ecc_error = 3; /* ECC area error; do not modify returned data. */
+        return;
+    }
+    for (i = 0; i < 11; i++) {
+        unsigned shift = i < 9 ? 2 * i : 28 + 2 * (i - 9);
+        unsigned pair = (diff >> shift) & 3;
+        if (pair != 1 && pair != 2) {
+            s->ecc_error = 2;
+            return;
+        }
+        byte |= (pair & 1) << i;
+    }
+    for (i = 0; i < 3; i++) {
+        unsigned pair = (diff >> (18 + 2 * i)) & 3;
+        if (pair != 1 && pair != 2) {
+            s->ecc_error = 2;
+            return;
+        }
+        bit |= (pair >> 1) << i;
+    }
+    s->ecc_error = byte < s->main_ecc.count ?
+                   1 | (bit << 4) | (byte << 7) : 2;
+}
