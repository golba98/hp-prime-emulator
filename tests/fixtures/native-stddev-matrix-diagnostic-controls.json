      "source": "EXPORT ZZT_MATDIAG()\nBEGIN\n  LOCAL D:=[[1,4],[3,8]], W:=[[1,1],[1,1]], S:=[[-1,1],[3,1]];\n  LOCAL R, Z, P, Q;\n  LOCAL T, U, V, factoryDiag;\n  LOCAL signedResult, N, K;\n  HComplex:=1;\n  A:=0;\n  IFERR R:=stddev([[0+1,4],[3,8]],W); THEN R:=\"caught\"; END;\n  IFERR Z:=stddev(D,[[-1,1],[3,1]]); THEN Z:=\"caught\"; END;\n  P:=stddev([[ (1 + 0), 4.00 ], [ 3E0, 8 ]],[[1,1],[1,1]]);\n  Q:=stddev([[1,4],[3,8]],[[0+1,1],[1,1]]);\n  T:=stddev([[.5+1,4],[3,8]],W);\n  U:=stddev([[1+(-1),4],[3,8]],W);\n  V:=stddev([[ZZT_TICK(),4],[3,8]],W);\n  factoryDiag:=stddev([[0+1,4],[3,8]],ZZT_MAKE());\n  signedResult:=stddev(D,S);\n  N:=stddev(D,W);\n  K:=stddev([[0+1,4],[3,8]],[[-1,1],[3,1]]);\n  L1:={R,Z,P,Q};\n  RETURN {{TYPE(R),R},{TYPE(Z),Z},{TYPE(P),P},{TYPE(Q),Q},\n          T,U,V,factoryDiag,A,{TYPE(signedResult),TYPE(signedResult(1)),ROUND(IM(signedResult(1)),8)},\n          {TYPE(N),N(1),N(2)},{TYPE(K),STRING(K)},INSTRING(R,CHAR(10))};\nEND;\nZZT_TICK()\nBEGIN\n  A:=A+1;\n  RETURN 1;\nEND;\nZZT_MAKE()\nBEGIN\n  A:=A+1;\n  RETURN [[1,1],[1,1]];\nEND;",
