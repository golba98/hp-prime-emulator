      "name": "save",
      "source": "EXPORT ZZT_STDMATRIX()\nBEGIN\n  LOCAL D:=[[1,4],[3,8]], W:=[[-1,1],[3,1]], R, Z, P, Q, T, V;\n  HComplex:=1;\n  R:=stddev(D,W);\n  W:=[[-1,1],[1,1]];\n  Z:=stddev(D,W);\n  L1:={R,Z};\n  W:=[[-1,-1],[-1,-1]];\n  P:=stddev(D,W);\n  W:=[[1,-1],[1,3]];\n  Q:=stddev([[1,4],[3,8]],W);\n  W:=[[-.5,1],[1.5,1]];\n  M2:=W;\n  T:=stddev(D,M2);\n  W:=[[2,2],[-1,1],[2,1]];\n  D:=[[-1,4],[0,6],[1,8]];\n  V:=stddev(D,W);\n  RETURN {{TYPE(R),TYPE(R(1)),TYPE(R(2)),ROUND(IM(R(1)),8),R(2)},\n          {TYPE(Z),SIZE(Z),TYPE(Z(1)),STRING(Z)},\n          {TYPE(P),P(1),P(2)},\n          {TYPE(Q),Q(1),ROUND(IM(Q(2)),8)},\n          {TYPE(T),ROUND(IM(T(1)),8),T(2)},\n          {TYPE(V),ROUND(V(1),8),ROUND(V(2),8)}};\nEND;",
      "entry": "ZZT_STDMATRIX",
