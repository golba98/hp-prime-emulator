      "source": "EXPORT ZZT_MATWIDTH()\nBEGIN\n  LOCAL D,W,R,S,T,Z,U;\n  HComplex:=1;\n  D:=[[1,4],[3,8]];\n  W:=[[1],[1]];\n  R:=stddev(D,W);\n  D:=[[1,4,100],[3,8,1000]];\n  W:=[[-1,1],[3,1]];\n  S:=stddev(D,W);\n  D:=[[1,4],[3,8]];\n  W:=[[2,1,-.5],[1,3,.5]];\n  T:=stddev(D,W);\n  D:=[[1,4,100],[3,8,1000]];\n  W:=[[-1,1],[1,1]];\n  Z:=stddev(D,W);\n  D:=[[1],[3]];\n  W:=[[-1,1],[3,1]];\n  U:=stddev(D,W);\n  L1:={R,S,T,Z,U};\n  RETURN {{TYPE(R),SIZE(R),TYPE(R(1)),R(1)},\n          {TYPE(S),SIZE(S),TYPE(S(1)),TYPE(S(2)),ROUND(IM(S(1)),8),RE(S(2))},\n          {TYPE(T),SIZE(T),TYPE(T(1)),TYPE(T(2)),ROUND(T(1),8),ROUND(T(2),8)},\n          {TYPE(Z),SIZE(Z),TYPE(Z(1)),STRING(Z)},\n          {TYPE(U),SIZE(U),TYPE(U(1)),ROUND(IM(U(1)),8)}};\nEND;",
