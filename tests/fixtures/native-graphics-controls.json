      "name": "GEOM",
      "source": "EXPORT GEOM()\nBEGIN\n LOCAL r:={}, c;\n IFERR DIMGROB_P(G1,6,1,{#1F:16h}); r:=CONCAT(r,{\"short\",GETPIX_P(G1,0,0),GETPIX_P(G1,3,0),GETPIX_P(G1,4,0)}); THEN r:=CONCAT(r,{\"short-error\"}); END;\n IFERR DIMGROB_P(G2,2,1,{#42100001:64h}); r:=CONCAT(r,{\"shades\",GETPIX_P(G2,0,0),GETPIX_P(G2,1,0)}); THEN r:=CONCAT(r,{\"shades-error\"}); END;\n IFERR DIMGROB_P(G3,2,1,{31}); r:=CONCAT(r,{\"real\",GETPIX_P(G3,0,0),GETPIX_P(G3,1,0)}); THEN r:=CONCAT(r,{\"real-error\"}); END;\n IFERR DIMGROB_P(G4,2,1,{}); r:=CONCAT(r,{\"empty\",GETPIX_P(G4,0,0)}); THEN r:=CONCAT(r,{\"empty-error\"}); END;\n DIMGROB_P(G5,150,50);\n IFERR c:=LINE_P(G5,{{10,10,1},{20,10,1}},{{1,2,#FF0000h}},{[[1,0,0,100],[0,1,0,0],[0,0,1,0]],\"\",-1,{0,30,0,30,0,30}}); r:=CONCAT(r,{\"clip\",GETPIX_P(G5,110,10),GETPIX_P(G5,15,10),DIM(c)}); THEN r:=CONCAT(r,{\"clip-error\"}); END;\n DIMGROB_P(G6,100,60);\n IFERR c:=LINE_P(G6,{{10,10,2},{20,10,4}},{{1,2,#FF0000h}},{-1,\"N\",{-60,-20,2}}); r:=CONCAT(r,{\"projection\",GETPIX_P(G6,70,30),GETPIX_P(G6,70,25),DIM(c)}); THEN r:=CONCAT(r,{\"projection-error\"}); END;\n RETURN r;\nEND;\n",
