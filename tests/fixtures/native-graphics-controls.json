      "source": "EXPORT AFFINE()\nBEGIN\n LOCAL r:={};\n DIMGROB_P(G1,100,100);\n IFERR LINE_P(G1,{{10,10,5},{20,10,5}},{{1,2,#FF0000h}},[[1,0,2],[0,1,3]]); r:=CONCAT(r,{\"matrix\",GETPIX_P(G1,12,13),GETPIX_P(G1,20,25)}); THEN r:=CONCAT(r,{\"matrix-error\"}); END;\n DIMGROB_P(G2,4,4); LOCAL z:=TRIANGLE_P(G2);\n IFERR TRIANGLE_P(G2,{0,0,#FFh,10},{4,0,#FFh,10},{0,4,#FFh,10},z); r:=CONCAT(r,{\"z\",DIM(z),ASC(LEFT(z,2)),GETPIX_P(G2,0,0),GETPIX_P(G2,1,1)}); THEN r:=CONCAT(r,{\"z-error\"}); END;\n RETURN r;\nEND;\n",
