      "source": "EXPORT ZEROFT() BEGIN LOCAL out:={},f,w,b,m,v,t,nn; LOCAL xxvals:={12345.6789,-99.9,0.00123,1},fmts:={1,1,3,2},prec:={10,10,2,2}; FOR b FROM 0 TO 1 DO FOR m FROM 0 TO 1 DO FOR f FROM 0 TO 2 DO FOR v FROM 1 TO 4 DO t:=STRING(xxvals(v),fmts(v),prec(v)); nn:=0; FOR w FROM 1 TO 100 DO IF STRING(xxvals(v),fmts(v),prec(v),-1,{w,f,b,0,m})==t THEN nn:=w; BREAK; END; END; out:=CONCAT(out,{{b,m,f,v,t,nn}}); END; END; END; END; RETURN STRING(out); END;",
