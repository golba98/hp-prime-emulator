   "step": "set_content",
   "content": "// Editor acceptance: valid HP Prime PPL using features the emulator lacks\n#pragma mode( separator(.,;) integer(h32) )\nEXPORT counter;\nSQUARE(n);\n\nEXPORT EDITDEMO(a, b)\nBEGIN\n  LOCAL i, total := 0, lst := {1, [2, 3], \"x\\\"y\"};\n  FOR i FROM 1 TO a DO\n    total := total + SQUARE(i) MOD 7;\n  END;\n  IF total > b AND NOT 0 THEN PRINT(\"big\\n\"); END;\n  INPUT(counter, \"Title\", \"c =\", \"help\", 1, 5);\n  counter := solve(x^2 = 4, x) + SOLVE(X^2-4, X, 1);\n  lst := append(lst, EVAL(\"1+2\"));\n  RETURN 'X+1' + #1Fh + 1.5E-3 + \u03c0;\nEND;\n\nSQUARE(n)\nBEGIN\n  RETURN n * n;\nEND;\n"
  },
